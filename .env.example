# Wildfire Risk Detection - Environment Variables
# Copy to .env and fill in values

# Backend
PORT=3001
NODE_ENV=development

# NASA FIRMS API (get free key at https://firms.modaps.eosdis.nasa.gov/api/area/)
NASA_FIRMS_API_KEY=

# ML Service
ML_SERVICE_URL=http://localhost:8001

# PostGIS (optional, for Phase 11+)
# DATABASE_URL=postgresql://wildfire:wildfire_dev@localhost:5432/wildfire
